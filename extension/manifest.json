{
  "manifest_version": 3,
  "name": "Tabs2Notion",
  "version": "0.1.1",
  "description": "Send one tab, a tab group, a window, or all open tabs to a Notion database.",
  "minimum_chrome_version": "123",
  "permissions": [
    "tabs",
    "storage",
    "contextMenus",
    "identity"
  ],
  "host_permissions": [
    "https://api.notion.com/*",
    "https://*.workers.dev/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Tabs2Notion",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "onboarding.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
